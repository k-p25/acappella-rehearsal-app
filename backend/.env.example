# Copy to backend/.env for local development.

# Local Postgres created by `createdb acappella_dev`.
# In production this is the Supabase connection string.
DATABASE_URL=postgresql://localhost:5432/acappella_dev

# Signs JWTs. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-in-production

# Origin allowed to call the API. Leave unset locally (Vite proxies /api).
# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
# CORS_ORIGIN=

PORT=3001
